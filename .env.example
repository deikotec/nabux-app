# Copia este archivo como .env.local y pega la configuración web de tu proyecto Firebase
# (Consola Firebase → Configuración del proyecto → Tus apps → App web → SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Pon "true" para usar los emuladores locales de Firebase (requiere Java + firebase-tools)
VITE_USE_EMULATORS=false

# --- IA (importación inteligente de inventario con Gemini vía Firebase AI Logic) ---
# Firebase exige App Check para usar AI Logic. Crea una clave de reCAPTCHA Enterprise,
# regístrala en Firebase → App Check (app web) y pégala aquí. Sin ella, la IA queda apagada
# y la importación funciona con reglas automáticas.
VITE_RECAPTCHA_SITE_KEY=
# "enterprise" (recomendado) o "v3"
VITE_RECAPTCHA_PROVIDER=enterprise
# Solo para localhost: pon "true", abre la consola del navegador, copia el token que aparece y
# regístralo en Firebase → App Check → Administrar tokens de depuración. Luego pega ese token aquí.
VITE_APPCHECK_DEBUG_TOKEN=
# Opcional: forzar modelos de Gemini (por defecto gemini-3.5-flash-lite y gemini-3.6-flash)
VITE_AI_MODEL=
VITE_AI_VISION_MODEL=
